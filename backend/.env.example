# Conexión a MongoDB Atlas (base nueva, ej: campeonato-juventud)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/campeonato-juventud
# Contraseña para entrar al panel /admin (solo vos la sabés)
ADMIN_PASSWORD=poné-una-contraseña-larga
# Texto largo y al azar para firmar las sesiones
JWT_SECRET=otro-texto-largo-al-azar
# URL del frontend en Vercel (para CORS). Podés poner varias separadas por coma.
FRONTEND_URL=https://campeonato-juventud.vercel.app
PORT=4000
